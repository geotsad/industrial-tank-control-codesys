    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">ef524fa7-6711-4235-b88a-04cfc3e63530</Single>
        <Single Name="ParentGuid" Type="System.Guid">d422a5c6-6a01-404c-9294-848591ef589f</Single>
        <Single Name="Name" Type="string">PRG_TankSimulation</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639261405568791425</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// ==========================================
// INDUSTRIAL TANK - PROCESS SIMULATION
// ==========================================


// Generate one process update approximately every second

fbPlantTick(
    IN := NOT fbPlantTick.Q,
    PT := T#1s
);


// ==========================================
// TANK LEVEL SIMULATION
// ==========================================

IF fbPlantTick.Q THEN

    // Water entering the tank
    IF PLC_PRG.xInletValveCmd THEN

        GVL_Tank.rActualTankLevel :=
            GVL_Tank.rActualTankLevel + rInletRatePctPerS;

    END_IF;


    // Water leaving the tank
    IF PLC_PRG.xMotorRun AND GVL_IO.xMotorFeedback THEN

        GVL_Tank.rActualTankLevel :=
            GVL_Tank.rActualTankLevel - rOutletRatePctPerS;

    END_IF;


    // Keep physical level between 0 and 100 %
    IF GVL_Tank.rActualTankLevel &gt; 100.0 THEN

        GVL_Tank.rActualTankLevel := 100.0;

    ELSIF GVL_Tank.rActualTankLevel &lt; 0.0 THEN

        GVL_Tank.rActualTankLevel := 0.0;

    END_IF;

END_IF;


// ==========================================
// AUTOMATIC MOTOR FEEDBACK SIMULATION
// ==========================================

fbMotorStartSim(
    IN := PLC_PRG.xMotorRun
          AND GVL_IO.xMotorHealthy
          AND NOT GVL_IO.xSimulateMotorFailure,
    PT := T#2s
);


// Simulated running feedback
GVL_IO.xMotorFeedback := fbMotorStartSim.Q;


// ==========================================
// LEVEL TRANSMITTER SIMULATION - LT-101
// ==========================================

IF GVL_IO.xSimulateLevelSignalLoss THEN

    // Fault injection: transmitter signal lost
    GVL_Tank.rLevelCurrent_mA := 0.0;

ELSE

    // Normal operation:
    // 0...100 % physical level -&gt; 4...20 mA
    GVL_Tank.rLevelCurrent_mA :=
        4.0 + (GVL_Tank.rActualTankLevel / 100.0) * 16.0;

END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">ef524fa7-6711-4235-b88a-04cfc3e63530_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PRG_TankSimulation
VAR

    fbPlantTick : TON;
	
	fbMotorStartSim : TON;

    rInletRatePctPerS : REAL := 2.0;

    rOutletRatePctPerS : REAL := 1.0;

END_VAR</Single>
