          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
    xStart : BOOL;
    xStop : BOOL;

    xLevelOK : BOOL;

    xRunRequest : BOOL;
    xMotorRun : BOOL;
	

    fbStartDelay : TON;
	fbFeedbackTimer : TON;
	
	tElapsedTime : TIME;
	tFeedbackWait : TIME;

	xStartFailure : BOOL;
	xFaultLatched : BOOL;
	
	xReset : BOOL;
	xResetAllowed : BOOL;
	
	fbFaultLatch : SR;
	
	fbStartEdge : R_TRIG;
	
	xStartPulse : BOOL;
	
	
	// AUTOMATIC TANK FILLING
	xFillStartCondition : BOOL;

	xFillStopCondition : BOOL;

	xInletValveCmd : BOOL;

	fbFillLatch : SR;
	
END_VAR</Single>
